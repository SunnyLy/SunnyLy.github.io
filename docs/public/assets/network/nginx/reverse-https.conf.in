# Complete main configuration; replace domain, upstream and certificate paths.
worker_processes auto;
pid logs/reverse-https.pid;
error_log logs/reverse-https-error.log warn;
events { worker_connections 1024; }

http {
    log_format proxy_site '$remote_addr "$request_method $uri" status=$status '
                          'upstream=$upstream_addr upstream_status=$upstream_status '
                          'request_time=$request_time upstream_time=$upstream_response_time';
    access_log logs/reverse-https-access.log proxy_site;

    upstream knowledge_app {
        server 127.0.0.1:__HTTP_PORT__;
        keepalive 16;
    }

    server {
        listen 80;
        server_name notes.example.com;
        # Fixed canonical domain; do not construct this from an untrusted Host.
        return 308 https://notes.example.com$request_uri;
    }

    server {
        listen 443 ssl;
        server_name notes.example.com;
        ssl_certificate /etc/nginx/tls/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        client_max_body_size 10m;

        location / {
            proxy_pass http://knowledge_app;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            # This example's nginx receives clients directly, without a CDN.
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Forwarded "";
            proxy_set_header X-Forwarded-Host "";
            proxy_set_header X-Real-IP "";
            proxy_connect_timeout 2s;
            proxy_send_timeout 30s;
            proxy_read_timeout 30s;
        }
    }
}
